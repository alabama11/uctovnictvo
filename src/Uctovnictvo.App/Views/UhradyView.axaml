<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:k="using:Uctovnictvo.App"
             x:Class="Uctovnictvo.App.Views.UhradyView">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,4,0,8">
      <Button Command="{Binding PridajUhraduCommand}">+ Pridať platbu</Button>
      <Button Command="{Binding ZmazUhraduCommand}">Zmazať vybranú</Button>
      <Button Command="{Binding ImportujVypisCommand}" ToolTip.Tip="Výpis z internet bankingu vo formáte XML (camt.053)">Importovať výpis z banky…</Button>
      <Button Command="{Binding ExcelUhradyCommand}">Export úhrad do Excelu…</Button>
      <TextBlock Classes="stitok" Text="Filter – byt:" Margin="14,0,0,0" />
      <ComboBox ItemsSource="{Binding Priestory}" SelectedItem="{Binding FilterUhradPriestor}" Width="120" PlaceholderText="všetky">
        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Cislo, StringFormat='byt {0}'}" /></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <Button Click="ZrusFilter">Všetky</Button>
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding SumaUhrad}" FontWeight="SemiBold" Margin="0,6,0,0" />
    <DataGrid x:Name="Tabulka" ItemsSource="{Binding Uhrady}" SelectedItem="{Binding VybranaUhrada}" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Dátum" Binding="{Binding Datum, Converter={StaticResource Datum}}" Width="110" />
        <DataGridTemplateColumn Header="Byt" Width="110">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate><TextBlock Margin="8,0" VerticalAlignment="Center" Text="{Binding Priestor.Cislo, StringFormat='byt {0}'}" /></DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
          <DataGridTemplateColumn.CellEditingTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{Binding $parent[DataGrid].DataContext.Priestory}" SelectedItem="{Binding Priestor}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Cislo, StringFormat='byt {0}'}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </DataTemplate>
          </DataGridTemplateColumn.CellEditingTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Suma €" Binding="{Binding Suma, Converter={StaticResource Eur}}" Width="110" CellStyleClasses="cislo" />
        <DataGridTemplateColumn Header="Účel" Width="190">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate><TextBlock Margin="8,0" VerticalAlignment="Center" Text="{Binding Ucel, Converter={StaticResource EnumText}}" /></DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
          <DataGridTemplateColumn.CellEditingTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{x:Static k:Zoznamy.Ucely}" SelectedItem="{Binding Ucel}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumText}}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </DataTemplate>
          </DataGridTemplateColumn.CellEditingTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="IBAN platiteľa" Binding="{Binding IbanPlatitela}" Width="270" />
        <DataGridTextColumn Header="VS" Binding="{Binding VariabilnySymbol}" Width="80" />
        <DataGridTextColumn Header="Poznámka" Binding="{Binding Poznamka}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
