<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:k="using:Uctovnictvo.App"
             x:Class="Uctovnictvo.App.Views.FondView">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Classes="popis" Margin="0,4,0,8" MaxWidth="980" HorizontalAlignment="Left"
               Text="Tvorba fondu sa počíta z predpisov položky „fond opráv“. Sem zapíšte počiatočný stav fondu (raz, k 1. 1. prvého roka v programe), čerpanie na opravy a iné príjmy (napr. úroky)." />
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <Button Command="{Binding PridajPohybFonduCommand}">+ Pridať pohyb</Button>
      <Button Command="{Binding ZmazPohybFonduCommand}">Zmazať vybraný</Button>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Background="#F1F4F7" CornerRadius="4" Padding="10,8" Margin="0,8,0,0">
      <TextBlock Text="{Binding StavFonduText}" FontWeight="SemiBold" TextWrapping="Wrap" />
    </Border>
    <DataGrid x:Name="Tabulka" ItemsSource="{Binding PohybyFondu}" SelectedItem="{Binding VybranyPohyb}" AutoGenerateColumns="False" HorizontalAlignment="Left" Width="900">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Dátum" Binding="{Binding Datum, Converter={StaticResource Datum}}" Width="110" />
        <DataGridTemplateColumn Header="Druh" Width="170">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate><TextBlock Margin="8,0" VerticalAlignment="Center" Text="{Binding Typ, Converter={StaticResource EnumText}}" /></DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
          <DataGridTemplateColumn.CellEditingTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{x:Static k:Zoznamy.TypyPohybuFondu}" SelectedItem="{Binding Typ}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumText}}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </DataTemplate>
          </DataGridTemplateColumn.CellEditingTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Popis" Binding="{Binding Popis}" Width="*" />
        <DataGridTextColumn Header="Suma €" Binding="{Binding Suma, Converter={StaticResource Eur}}" Width="130" CellStyleClasses="cislo" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
