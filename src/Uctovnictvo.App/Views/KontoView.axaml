<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Uctovnictvo.App.ViewModels"
             x:Class="Uctovnictvo.App.Views.KontoView">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,4,0,8">
      <TextBlock Classes="stitok" Text="Stav ku koncu mesiaca:" />
      <ComboBox ItemsSource="{x:Static vm:MainViewModel.MesiaceRoka}" SelectedItem="{Binding KontoKuMesiacu}" Width="80" />
      <CheckBox IsChecked="{Binding LenDlznici}" Content="len dlžníci" Margin="8,0" />
      <Button Command="{Binding ObnovKontaCommand}">Obnoviť</Button>
      <Button Command="{Binding UpomienkyPdfCommand}">Upomienky dlžníkom (PDF)…</Button>
      <Button Command="{Binding UpomienkyEmailCommand}" IsEnabled="{Binding !Odosiela}">Poslať upomienky e-mailom…</Button>
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding SumaKont}" FontWeight="SemiBold" Margin="0,6,0,0" />
    <Grid ColumnDefinitions="3*,12,2*">
      <DataGrid ItemsSource="{Binding Konta}" SelectedItem="{Binding VybraneKonto}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Byt" Binding="{Binding Priestor.Cislo}" Width="64" />
          <DataGridTextColumn Header="Vlastník" Binding="{Binding Priestor.MenaVlastnikov}" Width="*" />
          <DataGridTextColumn Header="Predpis" Binding="{Binding PredpisDoteraz, Converter={StaticResource Eur}}" Width="100" CellStyleClasses="cislo" />
          <DataGridTextColumn Header="Zaplatené" Binding="{Binding ZaplateneDoteraz, Converter={StaticResource Eur}}" Width="100" CellStyleClasses="cislo" />
          <DataGridTextColumn Header="Zostatok" Binding="{Binding Zostatok, Converter={StaticResource Eur}}" Width="100" CellStyleClasses="cislo" FontWeight="SemiBold" />
          <DataGridTextColumn Header="Mes. dlhu" Binding="{Binding MesiacovDlhu}" Width="100" CellStyleClasses="cislo" />
        </DataGrid.Columns>
      </DataGrid>
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6" Text="{Binding VybraneKonto.Priestor.Cislo, StringFormat='Konto bytu {0} po mesiacoch'}" />
        <TextBlock DockPanel.Dock="Top" Classes="popis" Margin="0,0,0,6" Text="{Binding VybraneKonto.ZostatokMinulyRok, Converter={StaticResource Eur}, StringFormat='Zostatok z minulého roka: {0}'}" />
        <DataGrid ItemsSource="{Binding KontoMesiace}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Mesiac" Binding="{Binding Mesiac}" Width="70" />
            <DataGridTextColumn Header="Predpis" Binding="{Binding Predpis, Converter={StaticResource Eur}}" Width="*" CellStyleClasses="cislo" />
            <DataGridTextColumn Header="Zaplatené" Binding="{Binding Zaplatene, Converter={StaticResource Eur}}" Width="*" CellStyleClasses="cislo" />
            <DataGridTextColumn Header="Zostatok" Binding="{Binding Zostatok, Converter={StaticResource Eur}}" Width="*" CellStyleClasses="cislo" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
