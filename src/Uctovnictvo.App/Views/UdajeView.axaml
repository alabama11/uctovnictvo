<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:k="using:Uctovnictvo.App"
             x:Class="Uctovnictvo.App.Views.UdajeView">
  <ScrollViewer>
    <Grid ColumnDefinitions="190,420" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="4,8" HorizontalAlignment="Left">
      <Grid.Styles>
        <Style Selector="TextBox, ComboBox">
          <Setter Property="Margin" Value="0,3" />
          <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
      </Grid.Styles>
      <TextBlock Grid.Row="0" Classes="stitok" Text="Typ" />
      <ComboBox Grid.Row="0" Grid.Column="1" x:Name="Typ" ItemsSource="{x:Static k:Zoznamy.TypyJednotiek}" SelectedItem="{Binding VybranaJednotka.Typ}">
        <ComboBox.ItemTemplate>
          <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumText}}" /></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Grid.Row="1" Classes="stitok" Text="Názov" />
      <TextBox Grid.Row="1" Grid.Column="1" x:Name="Nazov" Text="{Binding VybranaJednotka.Nazov}" />
      <TextBlock Grid.Row="2" Classes="stitok" Text="IČO" />
      <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding VybranaJednotka.Ico}" />
      <TextBlock Grid.Row="3" Classes="stitok" Text="DIČ" />
      <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding VybranaJednotka.Dic}" />
      <TextBlock Grid.Row="4" Classes="stitok" Text="Ulica a číslo" />
      <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding VybranaJednotka.Ulica}" />
      <TextBlock Grid.Row="5" Classes="stitok" Text="Obec" />
      <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding VybranaJednotka.Obec}" />
      <TextBlock Grid.Row="6" Classes="stitok" Text="PSČ" />
      <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding VybranaJednotka.Psc}" />
      <TextBlock Grid.Row="7" Classes="stitok" Text="IBAN – účet na platby" />
      <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding VybranaJednotka.Iban}" Watermark="SK.. .... .... .... .... ...." />
      <TextBlock Grid.Row="8" Classes="stitok" Text="IBAN – fond opráv" IsVisible="{Binding JeSpolocenstvo}" />
      <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding VybranaJednotka.IbanFondOprav}" IsVisible="{Binding JeSpolocenstvo}" />
      <TextBlock Grid.Row="9" Classes="stitok" Text="Predseda / štatutár" />
      <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding VybranaJednotka.Statutar}" />
      <TextBlock Grid.Row="10" Classes="stitok" Text="E-mail" />
      <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding VybranaJednotka.Email}" />
      <TextBlock Grid.Row="11" Classes="stitok" Text="Telefón" />
      <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding VybranaJednotka.Telefon}" />
      <TextBlock Grid.Row="12" Classes="stitok" Text="Poznámka" VerticalAlignment="Top" Margin="0,8,0,0" />
      <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding VybranaJednotka.Poznamka}" AcceptsReturn="True" Height="80" TextWrapping="Wrap" />
      <Button Grid.Row="13" Grid.Column="1" Classes="hlavne" Margin="0,10" Command="{Binding UlozCommand}">Uložiť</Button>
    </Grid>
  </ScrollViewer>
</UserControl>
