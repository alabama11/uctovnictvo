<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:k="using:Uctovnictvo.App"
             x:Class="Uctovnictvo.App.Views.PriestoryView">
  <Grid RowDefinitions="Auto,*,Auto,400">
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,8">
      <Button Command="{Binding PridajPriestorCommand}">+ Pridať byt / priestor</Button>
      <Button Command="{Binding ZmazPriestorCommand}">Zmazať vybraný</Button>
      <Button Command="{Binding PodielyZPlochyCommand}" ToolTip.Tip="Podiel = plocha bytu × 100 / súčet plôch všetkých bytov × 100">Prepočítať podiely z plochy</Button>
      <Button Command="{Binding SablonaExcelCommand}" ToolTip.Tip="Excel so všetkými bytmi, vlastníkmi a predpismi – dá sa upraviť a naimportovať späť">Export / šablóna Excel…</Button>
      <Button Command="{Binding ImportZExceluCommand}">Import z Excelu…</Button>
      <Button Command="{Binding PrezencnaListinaCommand}">Prezenčná listina…</Button>
      <TextBlock Classes="popis" VerticalAlignment="Center" Text="{Binding Priestory.Count, StringFormat='Počet: {0}'}" Margin="10,0" />
    </StackPanel>
    <DataGrid Grid.Row="1" ItemsSource="{Binding Priestory}" SelectedItem="{Binding VybranyPriestor}" AutoGenerateColumns="False" FrozenColumnCount="1">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Číslo" Binding="{Binding Cislo}" Width="76" />
        <DataGridTemplateColumn Header="Typ" Width="150">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate><TextBlock Margin="8,0" VerticalAlignment="Center" Text="{Binding Typ, Converter={StaticResource EnumText}}" /></DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
          <DataGridTemplateColumn.CellEditingTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{x:Static k:Zoznamy.TypyPriestorov}" SelectedItem="{Binding Typ}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumText}}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </DataTemplate>
          </DataGridTemplateColumn.CellEditingTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Vchod" Binding="{Binding Vchod}" Width="76" />
        <DataGridTextColumn Header="Poschodie" Binding="{Binding Poschodie}" Width="90" />
        <DataGridTextColumn Header="Plocha m²" Binding="{Binding Plocha, Converter={StaticResource Eur}}" Width="100" CellStyleClasses="cislo" />
        <DataGridTextColumn Header="Balkón m²" Binding="{Binding PlochaBalkona, Converter={StaticResource Eur}}" Width="100" CellStyleClasses="cislo" />
        <DataGridTextColumn Header="Osoby" Binding="{Binding PocetOsob}" Width="76" />
        <DataGridTextColumn Header="Podiel" Binding="{Binding PodielCitatel}" Width="85" />
        <DataGridTextColumn Header="/ z celku" Binding="{Binding PodielMenovatel}" Width="95" />
        <DataGridTextColumn Header="VS" Binding="{Binding VariabilnySymbol}" Width="80" />
        <DataGridTextColumn Header="Č. vodomeru 1" Binding="{Binding CisloVodomeru}" Width="120" />
        <DataGridTextColumn Header="Č. vodomeru 2 výmena" Binding="{Binding CisloVodomeru2}" Width="170" />
        <DataGridTextColumn Header="Vlastníci" Binding="{Binding MenaVlastnikov}" IsReadOnly="True" Width="220" />
        <DataGridTextColumn Header="Poznámka" Binding="{Binding Poznamka}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
    <GridSplitter Grid.Row="2" Height="6" Background="Transparent" ResizeDirection="Rows" />
    <Grid Grid.Row="3" RowDefinitions="*,10,150">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
          <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding VybranyPriestor.Cislo, StringFormat='Vlastníci priestoru {0}'}" />
          <Button Command="{Binding PridajVlastnikaCommand}">+ Vlastník</Button>
          <Button Command="{Binding ZmazVlastnikaCommand}">Zmazať</Button>
          <TextBlock Classes="popis" VerticalAlignment="Center" Margin="10,0,0,0"
                     Text="Spoluvlastník = ďalší riadok s podielom (napr. 1/2). Pri predaji: „Vlastník do“ a „Vlastník od“." />
        </StackPanel>
        <DataGrid ItemsSource="{Binding Vlastnici}" SelectedItem="{Binding VybranyVlastnik}" AutoGenerateColumns="False" FrozenColumnCount="1">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Meno a priezvisko / názov" Binding="{Binding Meno}" Width="2*" MinWidth="200" />
            <DataGridCheckBoxColumn Header="Vlastník" Binding="{Binding JeVlastnik}" Width="90" />
            <DataGridTextColumn Header="Spoluvlastnícky podiel" Binding="{Binding SpoluvlastnickyPodiel}" Width="190" />
            <DataGridTemplateColumn Header="Vlastník od" Width="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBox Text="{Binding VlastnikOd, Converter={StaticResource Datum}}" Watermark="d.m.rrrr" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Vlastník do" Width="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBox Text="{Binding VlastnikDo, Converter={StaticResource Datum}}" Watermark="d.m.rrrr" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridCheckBoxColumn Header="Kontakt" Binding="{Binding Hlavny}" Width="90" />
            <DataGridTextColumn Header="Ulica" Binding="{Binding Ulica}" Width="*" MinWidth="140" />
            <DataGridTextColumn Header="Obec" Binding="{Binding Obec}" Width="*" MinWidth="120" />
            <DataGridTextColumn Header="PSČ" Binding="{Binding Psc}" Width="80" />
            <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="*" MinWidth="160" />
            <DataGridTextColumn Header="Telefón" Binding="{Binding Telefon}" Width="120" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
      <DockPanel Grid.Row="2">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
          <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding VybranyVlastnik.Meno, StringFormat='Účty, z ktorých platí: {0}'}" />
          <Button Command="{Binding PridajUcetCommand}">+ Účet</Button>
          <Button Command="{Binding ZmazUcetCommand}">Zmazať</Button>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Ucty}" SelectedItem="{Binding VybranyUcet}" AutoGenerateColumns="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="IBAN" Binding="{Binding Iban}" Width="320" />
            <DataGridTextColumn Header="Kontrola" Binding="{Binding Iban, Converter={x:Static k:IbanKontrolaPrevodnik.Instance}}" IsReadOnly="True" Width="100" />
            <DataGridTextColumn Header="Poznámka" Binding="{Binding Poznamka}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Grid>
  </Grid>
</UserControl>
