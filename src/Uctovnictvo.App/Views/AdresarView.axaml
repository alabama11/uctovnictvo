<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Uctovnictvo.App.Views.AdresarView">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <Button Classes="hlavne" Command="{Binding PridajPartneraCommand}">+ Nový partner</Button>
      <Button Command="{Binding ZmazPartneraCommand}">Zmazať</Button>
    </StackPanel>
    <Grid ColumnDefinitions="2*,12,3*">
      <ListBox ItemsSource="{Binding Partneri}" SelectedItem="{Binding VybranyPartner}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <TextBlock Text="{Binding Nazov}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Ico, StringFormat='IČO {0}'}" FontSize="11" Foreground="#666" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <ScrollViewer Grid.Column="2" DataContext="{Binding VybranyPartner}" IsVisible="{Binding $parent[UserControl].DataContext.VybranyPartner, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" MaxWidth="560" HorizontalAlignment="Left">
          <Grid.Styles>
            <Style Selector="TextBox"><Setter Property="Margin" Value="0,3" /></Style>
          </Grid.Styles>
          <TextBlock Classes="stitok" Text="IČO" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <TextBox Width="140" Text="{Binding Ico}" />
            <Button Command="{Binding $parent[UserControl].DataContext.NacitajPodlaIcoCommand}">Načítať z registra</Button>
          </StackPanel>
          <TextBlock Grid.Row="1" Classes="stitok" Text="Názov" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Nazov}" />
          <TextBlock Grid.Row="2" Classes="stitok" Text="DIČ" />
          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Dic}" />
          <TextBlock Grid.Row="3" Classes="stitok" Text="IČ DPH" />
          <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding IcDph}" />
          <TextBlock Grid.Row="4" Classes="stitok" Text="Ulica a číslo" />
          <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Ulica}" />
          <TextBlock Grid.Row="5" Classes="stitok" Text="PSČ a obec" />
          <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <TextBox Width="80" Text="{Binding Psc}" />
            <TextBox Width="300" Text="{Binding Obec}" />
          </StackPanel>
          <TextBlock Grid.Row="6" Classes="stitok" Text="Štát" />
          <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Stat}" Watermark="prázdne = Slovensko" />
          <TextBlock Grid.Row="7" Classes="stitok" Text="E-mail" />
          <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Email}" />
          <TextBlock Grid.Row="8" Classes="stitok" Text="Telefón" />
          <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Telefon}" />
          <TextBlock Grid.Row="9" Classes="stitok" Text="IBAN" />
          <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Iban}" Watermark="na párovanie platieb dodávateľom" />
          <TextBlock Grid.Row="10" Classes="stitok" Text="Poznámka" />
          <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding Poznamka}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" />
          <TextBlock Grid.Row="11" Grid.Column="1" Classes="popis" TextWrapping="Wrap" Margin="0,6"
                     Text="„Načítať z registra“ doplní názov a adresu z Registra právnických osôb (Štatistický úrad SR). Potrebuje internet. DIČ v registri nie je, doplňte ho ručne." />
        </Grid>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
