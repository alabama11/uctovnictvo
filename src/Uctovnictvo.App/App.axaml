<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:k="using:Uctovnictvo.App"
             x:Class="Uctovnictvo.App.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <k:DesatinnyPrevodnik x:Key="Eur" Miesta="2" />
    <k:DesatinnyPrevodnik x:Key="M3" Miesta="3" />
    <k:DesatinnyPrevodnik x:Key="M3Prazdne" Miesta="3" PovolitPrazdne="True" />
    <k:DatumPrevodnik x:Key="Datum" />
    <k:EnumTextPrevodnik x:Key="EnumText" />
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <Style Selector="DataGrid">
      <Setter Property="GridLinesVisibility" Value="All" />
      <Setter Property="HorizontalGridLinesBrush" Value="#E2E6EA" />
      <Setter Property="VerticalGridLinesBrush" Value="#E2E6EA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#C9D1D9" />
      <Setter Property="CanUserReorderColumns" Value="False" />
    </Style>
    <Style Selector="DataGrid">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="6,2" />
    </Style>
    <Style Selector="DataGridRow">
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="DataGridCell.cislo">
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
    <Style Selector="TabControl > TabItem">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="TabControl TabControl > TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="TextBlock.nadpis">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.popis">
      <Setter Property="Foreground" Value="#5A6570" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.stitok">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#3A4550" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Padding" Value="12,5" />
    </Style>
    <Style Selector="Button.hlavne">
      <Setter Property="Background" Value="#1E5AA0" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.hlavne:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#174A86" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Application.Styles>
</Application>
